{
  "mcpServers": {
    "shopline-api": {
      "command": "python",
      "args": ["ecommerce/scripts/shopline_api.py"],
      "env": {
        "SHOPLINE_API_TOKEN": "${SHOPLINE_API_TOKEN}",
        "SHOPLINE_STORE": "sanshisan",
        "APIFY_TOKEN": "${APIFY_TOKEN}"
      }
    },
    "1688-scraper": {
      "command": "npx",
      "args": ["-y", "@apify/actors-mcp-server", "--actors", "futurizerush~1688-com-products-scraper"],
      "env": {
        "APIFY_TOKEN": "${APIFY_TOKEN}"
      }
    }
  }
}
